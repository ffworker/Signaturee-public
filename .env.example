# Signaturee v2 — single local configuration file
# Copy this file to .env in the repository root. .env is git-ignored.
# Required values have NO leading "#". Optional values stay commented.
# No inline comments after a value. Use UTF-8. JSON values must be on one line.

# ─────────────────────────────────────────────────────────────────────────────
# 1. WEB SERVER / LOGIN
# ─────────────────────────────────────────────────────────────────────────────
SIGNATUREE_CONFIG_MODE=env
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
# Add your HTTPS reverse proxy origin here (scheme, hostname, optional port).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AUTH_REQUIRED=true
AUTH_DB_LOGIN_ENABLED=true
AUTH_DB_PATH=config/signaturee_auth.db
DB_PATH=config/signaturee.db

# ─────────────────────────────────────────────────────────────────────────────
# 2. ACTIVE DIRECTORY: USER SEARCH AND SIGNATURE GENERATION
# ─────────────────────────────────────────────────────────────────────────────
# AD_SERVER: use a resolvable domain controller hostname, not a raw IP.
AD_SERVER=dc01.example.local
# OU_SEARCH_BASE: which subtree contains your users?
# DC=example,DC=local searches the whole domain (good first test).
# Restrict to OU=Staff,DC=example,DC=local ONLY if that OU actually exists.
OU_SEARCH_BASE=DC=example,DC=local

# AD searches normally run as the Windows Scheduled Task's identity (SYSTEM
# uses DOMAIN\COMPUTER$ for domain resources). No Domain Admin is needed.
# If Get-ADUser fails with access denied, use a dedicated READ-ONLY AD account.
# Set both or neither. Never use a Domain Admin account.
# AD_QUERY_USERNAME=EXAMPLE\svc_signaturee_read
# AD_QUERY_PASSWORD=replace-with-the-read-only-account-password

# ─────────────────────────────────────────────────────────────────────────────
# 3. LDAP: EMPLOYEES SIGN IN WITH THEIR OWN AD PASSWORD
# ─────────────────────────────────────────────────────────────────────────────
# LDAP login is SEPARATE from Get-ADUser search in section 2.
AUTH_LDAP_ENABLED=true
AUTH_LDAP_DOMAIN=example.local
# Optional: set only when the machine's domain/DC discovery isn't sufficient.
# AUTH_LDAP_SERVER=dc01.example.local
# Optional: force suffix for unqualified usernames. Must match real AD UPN.
# AUTH_LDAP_UPN_SUFFIX=example.local
# IMPORTANT: leave container unset at first. A wrong OU blocks user lookup.
# AUTH_LDAP_CONTAINER=OU=Staff,DC=example,DC=local

# Optional: promote selected LDAP users to IT via a role rule (never Admin).
# AUTH_LDAP_ROLE_RULES_JSON={"rules":[{"groupDn":"CN=Signaturee-IT,OU=Groups,DC=example,DC=local","role":"it"}]}

# ─────────────────────────────────────────────────────────────────────────────
# 4. OUTPUT / TEMPLATES
# ─────────────────────────────────────────────────────────────────────────────
SIGNATUREE_ORGANIZATION_NAME=Example Organization
# Local folder under the project root; created when the backend starts.
LOCAL_DEPLOYMENT_PATH=generatedsignatures
# UNC path for PRODUCTION: exact Windows syntax \\server\share\folder.
# The backend task identity needs SHARE + NTFS write and ACL-edit rights.
NETWORK_DEPLOYMENT_PATH=\\fileserver.example.local\Signatures
# Store your .htm, .txt, images and resource folders here (git-ignored).
TEMPLATE_DIR=config/templates

# ─────────────────────────────────────────────────────────────────────────────
# 5. WHICH AD GROUP GETS WHICH SIGNATURE?
# ─────────────────────────────────────────────────────────────────────────────
# Replace this example with your actual group DN and template filenames.
# ONE line of JSON. Repeat the signature key inside the JSON for more types.
SIGNATUREE_SIGNATURES_JSON={"example":{"label":"Example","adGroups":["CN=Signaturee-Example,OU=Groups,DC=example,DC=local"],"templateHtml":"example_template.htm","templateTxt":"example_template.txt"}}

# OPTIONAL advanced settings. Default variable mapping covers normal AD fields
# (givenName, sn, mail, department, description, telephoneNumber, mobile, etc.).
# SIGNATUREE_SECONDARY_TITLE_ATTRIBUTES=extensionAttribute6,extensionAttribute7
# SIGNATUREE_VARIABLES_JSON={"variables":[...],"ordering":[...]}
# SIGNATUREE_PROFILE_JSON={"organization":{...},"directory":{...},"targets":{...},"signatures":{...}}
# Avoid SIGNATUREE_PROFILE_JSON unless you deliberately remove overlapping keys.

# Optional: custom task names / frontend health-check URL
# RUNNER_BACKEND_TASK_NAME=Signaturee-Backend-Runner
# RUNNER_FRONTEND_TASK_NAME=Signaturee-Frontend-Runner
