# Signaturee v2 — SINGLE source of truth for a fresh installation.
# Copy to .env in the project root. NEVER commit your .env.
# For Windows: no trailing comments after values; JSON must be on ONE line.

SIGNATUREE_CONFIG_MODE=env
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
BACKEND_BASE_PATH=/
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AUTH_REQUIRED=true
AUTH_DB_LOGIN_ENABLED=true
AUTH_DB_PATH=config/signaturee_auth.db
DB_PATH=config/signaturee.db
AUTH_LDAP_ENABLED=false
# AUTH_LDAP_DOMAIN=example.local
# AUTH_LDAP_SERVER=dc01.example.local
# AUTH_LDAP_CONTAINER=OU=Users,DC=example,DC=local
# AUTH_LDAP_ROLE_RULES_PATH=config/ldap-role-rules.json
# AUTH_LDAP_UPN_SUFFIX=example.local

# v2 profile: these settings always override an old profile_v2 in SQLite.
SIGNATUREE_ORGANIZATION_NAME=Example Organization
AD_SERVER=dc01.example.local
OU_SEARCH_BASE=OU=Users,DC=example,DC=local
LOCAL_DEPLOYMENT_PATH=generatedsignatures
# Windows UNC (replace with YOUR share); PowerShell and Node receive the literal backslashes.
NETWORK_DEPLOYMENT_PATH=\\fileserver.example.local\Signatures
# Local, untracked templates directory; copy/import templates here.
TEMPLATE_DIR=config/templates

# Map each signature name to groups and template files. Keep JSON on ONE line.
SIGNATUREE_SIGNATURES_JSON={"example":{"label":"Example","adGroups":["CN=Signaturee-Example,OU=Groups,DC=example,DC=local"],"templateHtml":"example_template.htm","templateTxt":"example_template.txt","resourceFolder":"","faxFallback":"","customTitleAttr":""}}
SIGNATUREE_SECONDARY_TITLE_ATTRIBUTES=extensionAttribute6,extensionAttribute7
SIGNATUREE_VARIABLES_JSON={"variables":[{"id":"givenName","required":true,"displayName":"Vorname","description":"Vorname","placeholders":["$givenname"]},{"id":"sn","required":true,"displayName":"Nachname","description":"Nachname","placeholders":["$sn"]},{"id":"mail","required":true,"displayName":"E-Mail","description":"E-Mail","placeholders":["$mail"],"adProperties":["mail","userPrincipalName"]},{"id":"domain","required":false,"displayName":"E-Mail-Domain","description":"Domäne","placeholders":["$domain"],"adProperties":["mail"]},{"id":"department","required":false,"displayName":"Abteilung","description":"Abteilung","placeholders":["$department"]},{"id":"description","required":false,"displayName":"Titel/Beschreibung","description":"Beschreibung","placeholders":["$description"]},{"id":"telephoneNumber","required":false,"displayName":"Telefon","placeholders":["$telephonenumber"],"adProperties":["telephoneNumber","otherTelephone","businessPhone","phone"]},{"id":"mobile","required":false,"displayName":"Mobil","description":"Handy-Nr.","placeholders":["$mobile"]},{"id":"fax","required":false,"displayName":"Fax","csvHeader":"facsimileTelephoneNumber","placeholders":["$fax"],"adProperties":["facsimileTelephoneNumber","fax","otherFacsimileTelephoneNumber"]},{"id":"sAMAccountName","required":true,"displayName":"sAMAccountName","description":"Login-Name","placeholders":["$sAMAccountName"]}],"ordering":["givenName","sn","mail","domain","department","description","telephoneNumber","mobile","fax","sAMAccountName"]}

# Optional: paste the complete output of scripts/export-profile-env.js into .env,
# instead of maintaining the individual business settings above.
# SIGNATUREE_PROFILE_JSON={"organization":{...},"directory":{...},...}
# CAUTION: individually set variables above ALWAYS override SIGNATUREE_PROFILE_JSON.

# Optional monitoring/service overrides
# RUNNER_BACKEND_TASK_NAME=Signaturee-Backend-Runner
# RUNNER_FRONTEND_TASK_NAME=Signaturee-Frontend-Runner
# RUNNER_FRONTEND_STATUS_URL=http://127.0.0.1:3000/login.html
# RUNNER_STATUS_TIMEOUT_MS=3000
