# Signaturee v2 — copy ONCE to <installation>\.env and edit locally.
# This is the only application/business configuration file. The real .env is
# Git-ignored; do not commit credentials. UTF-8, KEY=value, no inline comments.
# Lines starting with # are OPTIONAL and disabled until you remove the #.

# =============================================================================
# 1. WEB SERVER & AUTHENTICATION
# =============================================================================
SIGNATUREE_CONFIG_MODE=env
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
# Include the exact HTTPS proxy origin when deployed behind a reverse proxy.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AUTH_REQUIRED=true
AUTH_DB_LOGIN_ENABLED=true
AUTH_DB_PATH=config/signaturee_auth.db
DB_PATH=config/signaturee.db

# =============================================================================
# 2. ACTIVE DIRECTORY USER SEARCH / GENERATION
# =============================================================================
# DC hostname/FQDN for Get-ADUser; do not use an IP if DNS is available.
AD_SERVER=dc01.example.local
# Existing distinguished name (DN). Start with the whole domain.
OU_SEARCH_BASE=DC=example,DC=local

# AD queries use the backend task identity by default (often SYSTEM, which is
# the machine account on the network). Domain Administrator is NOT required.
# If a dedicated read identity is necessary, set BOTH lines below.
# These credentials do NOT change LDAP login or SMB file-share authentication.
# AD_QUERY_USERNAME=EXAMPLE\svc_signaturee_read
# AD_QUERY_PASSWORD=REPLACE_WITH_PRIVATE_READ_ONLY_PASSWORD

# =============================================================================
# 3. EMPLOYEE LDAP LOGIN
# =============================================================================
AUTH_LDAP_ENABLED=true
AUTH_LDAP_DOMAIN=example.local
# Only set optional fields when needed for your AD environment.
# AUTH_LDAP_SERVER=dc01.example.local
# AUTH_LDAP_UPN_SUFFIX=example.local
# AUTH_LDAP_CONTAINER=OU=Employees,DC=example,DC=local

# LDAP role rules are NOT needed to assign signatures! They only elevate an
# eligible LDAP login from Self-Service to IT; LDAP never grants local Admin.
# AUTH_LDAP_ROLE_RULES_JSON={"rules":[{"groupDn":"CN=Signaturee-IT,OU=Groups,DC=example,DC=local","role":"it"}]}

# =============================================================================
# 4. OUTPUT & TEMPLATE FILES
# =============================================================================
SIGNATUREE_ORGANIZATION_NAME=Example Organization
# Local preview target, relative to the installed repository.
LOCAL_DEPLOYMENT_PATH=generatedsignatures
# Production Windows UNC: \\server\share\folder; NOT a mapped drive.
# The BACKEND TASK identity needs share + NTFS write and ACL-change rights.
NETWORK_DEPLOYMENT_PATH=\\fileserver.example.local\Signatures
# Source of HTML/TXT templates and image/resource folders. Git-ignored.
TEMPLATE_DIR=config/templates

# =============================================================================
# 5. AD SIGNATURE GROUPS — AUTOMATIC TEMPLATE DISCOVERY
# =============================================================================
# XY_Template.htm + XY_Template.txt -> signature XY -> existing group Signature-XY
# For example: AD_Template.htm + AD_Template.txt -> Signature-AD
# An optional AD-Dateien/ folder is picked up automatically.
# Example templates are skipped. A missing file from a pair is an error.
SIGNATUREE_SIGNATURES_AUTO_DISCOVER=true
# If your real AD groups are named Signatur-AD instead of Signature-AD:
# SIGNATUREE_AUTO_GROUP_PREFIX=Signatur-

# Advanced alternative: disable discovery and provide a one-line explicit map.
# SIGNATUREE_SIGNATURES_AUTO_DISCOVER=false
# SIGNATUREE_SIGNATURES_JSON={"AD":{"label":"AD","adGroups":["CN=Signature-AD,OU=Groups,DC=example,DC=local"],"templateHtml":"AD_Template.htm","templateTxt":"AD_Template.txt","resourceFolder":"AD-Dateien"}}

# Additions/overrides from Admin -> Variablen are stored automatically in:
# SIGNATUREE_VARIABLES_EXTRA_JSON=[{"id":"standort","placeholders":["$standort"],"adProperties":["extensionAttribute10"],"required":false}]
# Built-in variables remain available; this key is generated by Admin on save.
# SIGNATUREE_SECONDARY_TITLE_ATTRIBUTES=extensionAttribute6,extensionAttribute7
# Advanced full replacement (not compatible with Admin variable editing):
# SIGNATUREE_VARIABLES_JSON={"variables":[...],"ordering":[...]}

# =============================================================================
# OPTIONAL OPERATIONS
# =============================================================================
# Web backend RTF default: LibreOffice (must be installed system-wide).
# Direct legacy GenerateSignatures.ps1 calls still default to Word unless -RtfEngine is supplied.
# Before production deployment, test one LOCAL signature under the actual runner account
# and verify the RTF/images in classic Outlook. No automatic fallback to Word on error.
# To explicitly keep the previous Word COM backend behavior:
# SIGNATUREE_RTF_ENGINE=word
# Optional full path if soffice is not on the SYSTEM task's PATH:
# SIGNATUREE_LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com

# RUNNER_BACKEND_TASK_NAME=Signaturee-Backend-Runner
# RUNNER_FRONTEND_TASK_NAME=Signaturee-Frontend-Runner
