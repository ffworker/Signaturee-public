# Signaturee v2 — SINGLE source of truth for a fresh installation.
# Copy to .env in the project root. NEVER commit your .env.
# For Windows: no trailing comments after values; JSON must be on ONE line.

SIGNATUREE_CONFIG_MODE=env
BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
BACKEND_BASE_PATH=/
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AUTH_REQUIRED=true
AUTH_DB_LOGIN_ENABLED=true
AUTH_DB_PATH=config/signaturee_auth.db
DB_PATH=config/signaturee.db
AUTH_LDAP_ENABLED=false
# AUTH_LDAP_DOMAIN=example.local
# AUTH_LDAP_SERVER=dc01.example.local
# AUTH_LDAP_CONTAINER=OU=Users,DC=example,DC=local
# AUTH_LDAP_ROLE_RULES_PATH=config/ldap-role-rules.json  # Only if you created this file!
# AUTH_LDAP_UPN_SUFFIX=example.local

# v2 profile: these settings always override an old profile_v2 in SQLite.
SIGNATUREE_ORGANIZATION_NAME=Example Organization
AD_SERVER=dc01.example.local
OU_SEARCH_BASE=OU=Users,DC=example,DC=local
LOCAL_DEPLOYMENT_PATH=generatedsignatures
# Windows UNC (replace with YOUR share); PowerShell and Node receive the literal backslashes.
NETWORK_DEPLOYMENT_PATH=\\fileserver.example.local\Signatures
# Local, untracked templates directory; copy/import templates here.
TEMPLATE_DIR=config/templates

# 1) ONE required JSON line: signature name, matching AD group, and template filenames.
# Match these filenames against the files copied to config/templates.
# Each signature entry needs adGroups, templateHtml and templateTxt.
SIGNATUREE_SIGNATURES_JSON={"example":{"label":"Example","adGroups":["CN=Signaturee-Example,OU=Groups,DC=example,DC=local"],"templateHtml":"example_template.htm","templateTxt":"example_template.txt"}}

# 2) OPTIONAL: Advanced attributes for title / description substitution.
# SIGNATUREE_SECONDARY_TITLE_ATTRIBUTES=extensionAttribute6,extensionAttribute7

# 3) OPTIONAL: Most users should NOT set SIGNATUREE_VARIABLES_JSON.
# Default mapping already includes first name, surname, email, domain, department,
# description, phone, mobile, fax, and sAMAccountName. Customize only if necessary.
# SIGNATUREE_VARIABLES_JSON={"variables":[...]}

# 4) OPTIONAL: LDAP roles. You do NOT need role rules for normal AD login.
# Only enable one of these after supplying a valid file or JSON:
# AUTH_LDAP_ROLE_RULES_JSON={"rules":[{"groupDn":"CN=Signaturee-IT,OU=Groups,DC=example,DC=local","role":"it"}]}
# AUTH_LDAP_ROLE_RULES_PATH=config/ldap-role-rules.json

# 5) OPTIONAL alternative: full profile exported from your old installation.
# When using SIGNATUREE_PROFILE_JSON, comment out individual business overrides
# above (including SIGNATUREE_SIGNATURES_JSON), otherwise they take precedence.
# SIGNATUREE_PROFILE_JSON={"organization":{...},"directory":{...},...}

# Optional monitoring/service overrides
# RUNNER_BACKEND_TASK_NAME=Signaturee-Backend-Runner
# RUNNER_FRONTEND_TASK_NAME=Signaturee-Frontend-Runner
# RUNNER_FRONTEND_STATUS_URL=http://127.0.0.1:3000/login.html
# RUNNER_STATUS_TIMEOUT_MS=3000
