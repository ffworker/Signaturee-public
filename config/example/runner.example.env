# Runner-specific backend process env.
# Copy to config/runner.env and adjust values.

BACKEND_HOST=0.0.0.0
BACKEND_PORT=3001
BACKEND_BASE_PATH=/

# For a same-origin reverse proxy this can usually be your public Signaturee origin.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AUTH_REQUIRED=true
AUTH_DB_PATH=config/signaturee_auth.db
AUTH_DB_LOGIN_ENABLED=true

# Employee LDAP/AD login
# AUTH_LDAP_ENABLED=false
# AUTH_LDAP_DOMAIN=contoso.local
# AUTH_LDAP_SERVER=dc01.contoso.local
# AUTH_LDAP_CONTAINER=OU=Users,DC=contoso,DC=local
# AUTH_LDAP_UPN_SUFFIX=contoso.local
# AUTH_LDAP_ROLE_RULES_PATH=config/ldap-role-rules.json
# Legacy AUTH_LDAP_ROLE_MAP supports canonical username:it entries only.
# AUTH_LDAP_FALLBACK_TO_DB=true

# Main v2 storage
# DB_PATH=config/signaturee.db

# Runtime runner monitor overrides
# RUNNER_BACKEND_TASK_NAME=Signaturee-Backend-Runner
# RUNNER_FRONTEND_TASK_NAME=Signaturee-Frontend-Runner
# RUNNER_FRONTEND_STATUS_URL=http://127.0.0.1:3000/login.html
# RUNNER_STATUS_TIMEOUT_MS=3000

# Business settings such as AD Search Base and deployment paths are configured
# in the Admin UI/profile_v2, not in this file.
